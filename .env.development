# Which assistant bundle `npm run dev` loads. Defaults to the CDN so the dev server works
# with no setup at all.
#
# To run the site against a bundle you are building locally, override this in .env.local
# (gitignored, so it stays yours):
#
#   VITE_ASSISTANT_BUNDLE_URL=http://localhost:10093/static/js/main.bundle.js
#
# In the code repo, `npm start` in frontend_assistant serves that bundle on port 10093
# with CORS enabled. Vite substitutes the value into index.html, and the prerender scripts
# read dist/index.html after the build, so every prerendered page inherits it too.
VITE_ASSISTANT_BUNDLE_URL=https://assistant-script.nobi.ai/nobi.bundle.js
